@startuml
title <size:24>Dynamic View: BiblioUNSA - API BiblioUNSA</size>\n<size:24>Dinámico: reservar un libro (equivale a la secuencia del Laboratorio 05).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(Estudiante, "Estudiante", $descr="Busca libros, los reserva y consulta sus préstamos y multas.", $tags="", $link="")

System(SistemaAcadémicoUNSA, "Sistema Académico UNSA", $descr="Informa si el estudiante tiene matrícula vigente.", $tags="", $link="")

System_Boundary("BiblioUNSA_boundary", "BiblioUNSA", $tags="") {
  Container_Boundary("BiblioUNSA.APIBiblioUNSA_boundary", "API BiblioUNSA", $tags="") {
    Component(BiblioUNSA.APIBiblioUNSA.MóduloNotificaciones, "Módulo Notificaciones", $techn="Django app", $descr="Genera avisos de reserva, vencimiento y multa.", $tags="", $link="")
    Component(BiblioUNSA.APIBiblioUNSA.AdaptadorSistemaacadémico, "Adaptador Sistema académico", $techn="Adaptador (puertos y adaptadores)", $descr="Implementa el puerto de matrícula consultando la API académica.", $tags="", $link="")
    Component(BiblioUNSA.APIBiblioUNSA.MóduloAutenticación, "Módulo Autenticación", $techn="Django app", $descr="Identifica a la persona y valida su matrícula mediante puertos.", $tags="", $link="")
    Component(BiblioUNSA.APIBiblioUNSA.MóduloCatálogo, "Módulo Catálogo", $techn="Django app", $descr="Libros, ejemplares y disponibilidad.", $tags="", $link="")
    Component(BiblioUNSA.APIBiblioUNSA.MóduloReservas, "Módulo Reservas", $techn="Django app", $descr="Crea reservas de ejemplares disponibles para estudiantes con matrícula vigente.", $tags="", $link="")
  }

  ContainerDb(BiblioUNSA.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Usuarios, libros, ejemplares, reservas, préstamos y multas (un esquema por módulo).", $tags="", $link="")
  ContainerQueue(BiblioUNSA.Colaycaché, "Cola y caché", $techn="Redis", $descr="Cola de tareas y caché corta de la matrícula (ADR-003).", $tags="", $link="")
  Container(BiblioUNSA.AplicaciónwebPWA, "Aplicación web (PWA)", $techn="HTML, JavaScript y Service Worker", $descr="Interfaz para estudiantes y bibliotecarios desde celular o PC.", $tags="", $link="")
}

Person(Estudiante, "Estudiante", $descr="Busca libros, los reserva y consulta sus préstamos y multas.", $tags="", $link="")
Container(BiblioUNSA.AplicaciónwebPWA, "Aplicación web (PWA)", $techn="HTML, JavaScript y Service Worker", $descr="Interfaz para estudiantes y bibliotecarios desde celular o PC.", $tags="", $link="")
ContainerDb(BiblioUNSA.Basededatos, "Base de datos", $techn="PostgreSQL", $descr="Usuarios, libros, ejemplares, reservas, préstamos y multas (un esquema por módulo).", $tags="", $link="")
ContainerQueue(BiblioUNSA.Colaycaché, "Cola y caché", $techn="Redis", $descr="Cola de tareas y caché corta de la matrícula (ADR-003).", $tags="", $link="")
System(SistemaAcadémicoUNSA, "Sistema Académico UNSA", $descr="Informa si el estudiante tiene matrícula vigente.", $tags="", $link="")

Rel(Estudiante, BiblioUNSA.AplicaciónwebPWA, "1: Pulsa «Reservar libro»", $techn="HTTPS", $tags="", $link="")
Rel(BiblioUNSA.AplicaciónwebPWA, BiblioUNSA.APIBiblioUNSA.MóduloReservas, "2: POST /reservas", $techn="HTTPS/JSON", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.MóduloReservas, BiblioUNSA.APIBiblioUNSA.MóduloAutenticación, "3: Identifica al estudiante", $techn="", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.MóduloAutenticación, BiblioUNSA.APIBiblioUNSA.AdaptadorSistemaacadémico, "4: Consulta la matrícula (puerto)", $techn="", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.AdaptadorSistemaacadémico, SistemaAcadémicoUNSA, "5: Consulta la matrícula vigente", $techn="HTTPS/JSON (API)", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.MóduloReservas, BiblioUNSA.APIBiblioUNSA.MóduloCatálogo, "6: Verifica ejemplar disponible", $techn="", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.MóduloReservas, BiblioUNSA.Basededatos, "7: Guarda la reserva", $techn="SQL", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.MóduloReservas, BiblioUNSA.APIBiblioUNSA.MóduloNotificaciones, "8: Confirma la reserva (asíncrono)", $techn="", $tags="", $link="")
Rel(BiblioUNSA.APIBiblioUNSA.MóduloNotificaciones, BiblioUNSA.Colaycaché, "9: Encola el aviso", $techn="Redis protocol", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml