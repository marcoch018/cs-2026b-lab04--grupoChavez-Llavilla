@startuml
title <size:24>Deployment View: BiblioUNSA - Producción</size>\n<size:24>Despliegue en producción (MVP).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.CelularoPCdelusuario, "Celular o PC del usuario", $type="Android, iOS o Windows; navegador web", $descr="", $tags="", $link="") {
  Container(Producción.CelularoPCdelusuario.AplicaciónwebPWA_1, "Aplicación web (PWA)", $techn="HTML, JavaScript y Service Worker", $descr="Interfaz para estudiantes y bibliotecarios desde celular o PC.", $tags="", $link="")
}

Deployment_Node(Producción.VPSenlanube, "VPS en la nube", $type="Ubuntu Server 24.04, 2 vCPU, 4 GB RAM", $descr="Un único servidor de bajo costo (R-03)", $tags="", $link="") {
  Deployment_Node(Producción.VPSenlanube.Nginx, "Nginx", $type="Nginx", $descr="Proxy inverso con HTTPS", $tags="", $link="")
  Deployment_Node(Producción.VPSenlanube.Monolitomodular, "Monolito modular", $type="Python 3 / Django", $descr="", $tags="", $link="") {
    Container(Producción.VPSenlanube.Monolitomodular.APIBiblioUNSA_1, "API BiblioUNSA", $techn="Python / Django", $descr="Monolito modular que implementa los casos de uso mediante una API REST (ADR-001).", $tags="", $link="")
    Container(Producción.VPSenlanube.Monolitomodular.Workerdetareas_1, "Worker de tareas", $techn="Celery", $descr="Ejecuta avisos, reintentos de validación de matrícula (ADR-003) y tareas programadas de vencimientos y multas.", $tags="", $link="")
  }

  Deployment_Node(Producción.VPSenlanube.Datos, "Datos", $type="Servicios locales del VPS", $descr="", $tags="", $link="") {
    ContainerDb(Producción.VPSenlanube.Datos.Basededatos_1, "Base de datos", $techn="PostgreSQL", $descr="Usuarios, libros, ejemplares, reservas, préstamos y multas (un esquema por módulo).", $tags="", $link="")
    ContainerQueue(Producción.VPSenlanube.Datos.Colaycaché_1, "Cola y caché", $techn="Redis", $descr="Cola de tareas y caché corta de la matrícula (ADR-003).", $tags="", $link="")
  }

}

Rel(Producción.CelularoPCdelusuario.AplicaciónwebPWA_1, Producción.VPSenlanube.Monolitomodular.APIBiblioUNSA_1, "Llama a", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(Producción.VPSenlanube.Monolitomodular.APIBiblioUNSA_1, Producción.VPSenlanube.Datos.Basededatos_1, "Lee y escribe", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.VPSenlanube.Monolitomodular.Workerdetareas_1, Producción.VPSenlanube.Datos.Basededatos_1, "Lee préstamos vencidos y registra multas", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.VPSenlanube.Monolitomodular.APIBiblioUNSA_1, Producción.VPSenlanube.Datos.Colaycaché_1, "Encola tareas y lee la caché", $techn="Redis protocol", $tags="", $link="")
Rel(Producción.VPSenlanube.Monolitomodular.Workerdetareas_1, Producción.VPSenlanube.Datos.Colaycaché_1, "Consume tareas", $techn="Redis protocol", $tags="", $link="")
Rel(Producción.CelularoPCdelusuario.AplicaciónwebPWA_1, Producción.VPSenlanube.Nginx, "Llama a", $techn="HTTPS", $tags="", $link="")
Rel(Producción.VPSenlanube.Nginx, Producción.VPSenlanube.Monolitomodular.APIBiblioUNSA_1, "Reenvía las peticiones", $techn="HTTP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml